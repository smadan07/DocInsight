# ============================================
# Smart Document Insights - Environment Config
# Copy to .env and adjust. All values have safe defaults; the app boots with
# none of these set (keyless demo mode with local embeddings).
# ============================================

# --- Application ---
APP_NAME=Smart Document Insights
APP_ENV=development
DEBUG=true
# Set a real random value in production (HF Space -> Settings -> Secrets).
SECRET_KEY=INSECURE-DEV-KEY-set-SECRET_KEY-env-var

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- OpenAI / LLM (optional) ---
# Leave empty to run in mock demo mode. The deployed UI also accepts a
# per-request bring-your-own-key, which overrides this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
# For OpenRouter / self-hosted OpenAI-compatible endpoints:
# OPENAI_API_BASE=https://openrouter.ai/api/v1

# --- Embeddings ---
# Local embeddings (all-MiniLM-L6-v2, 384-dim) need no API key. Keep true for
# the keyless/CPU demo. Stays local even when an LLM key is provided.
USE_LOCAL_EMBEDDINGS=true
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector Store ---
FAISS_INDEX_PATH=./data/faiss_index

# --- Background Processing ---
# false = process uploads inline (no Celery/Redis). Only set true with a real
# Celery worker + Redis broker running.
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# --- File Upload ---
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./data/uploads
ALLOWED_EXTENSIONS=pdf,docx,txt

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- CORS ---
# Single-container deploy is same-origin; "*" is fine. Tighten if you split origins.
CORS_ORIGINS=*

# --- Server ---
# Container listens here; matches the HF Space app_port.
PORT=7860
